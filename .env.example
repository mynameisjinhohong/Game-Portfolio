# ============================================================
# 로컬 LLM 서버 연결 설정 예시
# 실제 값을 채운 뒤 .env 파일로 복사하여 사용하세요.
# 이 파일 자체는 저장소에 커밋되어도 안전합니다.
# ============================================================

# 로컬 LLM 서버 주소 (Ollama 기본값: http://localhost:11434)
NEXT_PUBLIC_CHATBOT_API_URL=http://localhost:11434

# 사용할 모델명 — `ollama list` 명령으로 설치된 모델명을 확인하세요
# 예: llama3, gemma3, mistral, qwen2 등
NEXT_PUBLIC_CHATBOT_MODEL=llama3

# API 요청 타임아웃 (밀리초 단위, 기본 30초)
LOCAL_LLM_TIMEOUT_MS=30000

# 생성할 최대 토큰 수 (기본값: 512)
LOCAL_LLM_MAX_TOKENS=512

# 시스템 프롬프트 파일 경로 (역할·보안 행동 지침 전용)
LOCAL_LLM_SYSTEM_PROMPT_PATH=./config/llm/system_prompt.txt

# 컨텍스트 문서 파일 경로 (홍진호 정보·프로젝트 요약 등 데이터 전용)
LOCAL_LLM_CONTEXT_PATH=./config/llm/context.txt

# 챗봇 기능 활성화 여부 (true | false)
CHATBOT_ENABLED=true
