# ──────────────────────────────────────────────
# 로컬 LLM (Ollama) 서버 설정
# Mac mini 에서 ollama serve 를 실행한 뒤 아래 값을 맞춰 주세요.
# ──────────────────────────────────────────────

# Ollama API 주소 (서버 사이드 전용)
LLM_BASE_URL=http://localhost:11434

# 사용할 모델 이름 (ollama pull <model> 로 미리 다운로드)
LLM_MODEL=llama3

# 챗봇 시스템 프롬프트 (한 줄로 작성)
LLM_SYSTEM_PROMPT=You are a helpful portfolio assistant for Hong Jinho, a game developer. Answer questions about his experience, projects, and skills in a friendly and concise way.

# ──────────────────────────────────────────────
# 클라이언트에서 직접 접근할 챗봇 API URL (Next.js /api/chat 라우트)
# 배포 시에는 실제 도메인으로 변경하세요.
# ──────────────────────────────────────────────
NEXT_PUBLIC_CHATBOT_API_URL=http://localhost:3000/api/chat

# ──────────────────────────────────────────────
# 사이트 기본 URL
# ──────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Node.js 환경 (development | production)
NODE_ENV=development
